
@misc{noauthor_newtons_2025,
	title = {Newton's method in optimization},
	copyright = {Creative Commons Attribution-ShareAlike License},
	url = {https://en.wikipedia.org/w/index.php?title=Newton%27s_method_in_optimization&oldid=1311976880},
	abstract = {In calculus, Newton's method (also called Newton–Raphson) is an iterative method for finding the roots of a differentiable function 
  
    
      
        f
      
    
    \{{\textbackslash}displaystyle f\}
  
, which are solutions to the equation 
  
    
      
        f
        (
        x
        )
        =
        0
      
    
    \{{\textbackslash}displaystyle f(x)=0\}
  
. However, to optimize a twice-differentiable 
  
    
      
        f
      
    
    \{{\textbackslash}displaystyle f\}
  
, our goal is to find the roots of 
  
    
      
        
          f
          ′
        
      
    
    \{{\textbackslash}displaystyle f'\}
  
. We can therefore use Newton's method on its derivative 
  
    
      
        
          f
          ′
        
      
    
    \{{\textbackslash}displaystyle f'\}
  
 to find solutions to 
  
    
      
        
          f
          ′
        
        (
        x
        )
        =
        0
      
    
    \{{\textbackslash}displaystyle f'(x)=0\}
  
, also known as the critical points of 
  
    
      
        f
      
    
    \{{\textbackslash}displaystyle f\}
  
. These solutions may be minima, maxima, or saddle points; see section "Several variables" in Critical point (mathematics) and also section "Geometric interpretation" in this article. This is relevant in optimization, which aims to find (global) minima of the function 
  
    
      
        f
      
    
    \{{\textbackslash}displaystyle f\}
  
.},
	language = {en},
	urldate = {2025-12-15},
	journal = {Wikipedia},
	month = sep,
	year = {2025},
	note = {Page Version ID: 1311976880},
}

